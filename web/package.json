{
  "name": "reearth-marketplace",
  "description": "Re:Earth marketplace for publishing and sharing plugins",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "build:ext": "tsc && vite build -c vite.config.ext.ts && node ./TEMP",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "type": "tsc",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "gql": "graphql-codegen --config codegen.yml",
    "i18n": "i18next"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/fragment-matcher": "8.0.0",
    "@graphql-codegen/introspection": "7.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@graphql-codegen/typescript-react-apollo": "6.0.1",
    "@rollup/plugin-yaml": "5.0.1",
    "@storybook/addon-actions": "9.0.8",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-links": "10.6.8",
    "@storybook/builder-vite": "10.6.8",
    "@storybook/react": "10.6.8",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.7.0",
    "babel-loader": "10.1.1",
    "babel-plugin-macros": "3.1.0",
    "eslint": "10.15.0",
    "eslint-config-reearth": "0.4.0",
    "eslint-plugin-graphql": "4.0.0",
    "eslint-plugin-import": "^2.32.0",
    "i18next-parser": "9.4.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "rollup-plugin-external-globals": "0.13.0",
    "rollup-plugin-visualizer": "7.1.3",
    "storybook-react-i18next": "10.1.5",
    "typescript": "7.0.2",
    "vite": "2.9.9",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vitest": "0.14.2"
  },
  "dependencies": {
    "@ant-design/compatible": "5.1.5",
    "@ant-design/cssinjs": "2.2.0",
    "@ant-design/icons": "6.3.4",
    "@ant-design/pro-layout": "7.22.7",
    "@ant-design/pro-table": "3.21.0",
    "@apollo/client": "4.3.8",
    "@auth0/auth0-react": "2.30.0",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@types/apollo-upload-client": "19.0.0",
    "antd": "6.7.1",
    "apollo-upload-client": "20.0.0",
    "dayjs": "1.11.23",
    "graphiql": "6.0.1",
    "graphql": "16.6.0",
    "i18next": "21.8.2",
    "i18next-browser-languagedetector": "8.3.1",
    "jotai": "3.0.2",
    "react": "19.3.1",
    "react-accessible-accordion": "5.0.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.6",
    "remark-gfm": "4.0.1",
    "tinycolor2": "1.6.0"
  },
  "msw": {
    "workerDirectory": "src/test/mocks"
  }
}
